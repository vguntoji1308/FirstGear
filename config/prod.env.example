# PROD environment template. Do NOT put real values in this file.
# Provide production values through your host's secret store / pipeline variable group as real
# environment variables (preferred), or a git-ignored config/prod.env on the server.
# The app REFUSES TO START in prod if JWT_SECRET / ADMIN_PASSWORD are missing, short or placeholders.

APP_ENV=prod
PORT=3000
DB_PATH=/app/data/prod.sqlite   # mount a persistent volume at /app/data
SEED_DEMO_DATA=false            # no demo reviews/testimonials in production

# --- Secrets (REQUIRED, inject from a secret store) ---
JWT_SECRET=                     # 32+ random chars:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_EMAIL=
ADMIN_PASSWORD=                 # 12+ chars, unique

# --- Web security ---
CORS_ORIGINS=                   # e.g. https://www.yourdomain.com (never *). Empty = same-origin only
TRUST_PROXY=true                # true when behind a load balancer / reverse proxy (correct client IPs for rate limiting)
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_LOGIN_MAX=10

# --- Optional customer phone sign-in: Twilio Verify (inject credentials through a secret store) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Business details (REPLACE the placeholder phone before go-live) ---
BUSINESS_NAME=
GOOGLE_REVIEWS_URL=            # public link to your Google Maps listing
BUSINESS_PHONE=                 # real click-to-call number, e.g. +14155550123
BUSINESS_EMAIL=
BUSINESS_ADDRESS=
BUSINESS_HOURS=
SOCIAL_FACEBOOK=https://www.facebook.com/myfirstgear
SOCIAL_INSTAGRAM=https://www.instagram.com/myfirstgear/
SOCIAL_X=https://x.com/myfirstgear
SOCIAL_YOUTUBE=https://www.youtube.com/@myfirstgear
SOCIAL_WHATSAPP=

# --- Optional Google reviews sync (see docs/GOOGLE_REVIEWS.md); the key is a SECRET: use your secret store ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Rental rules ---
CURRENCY=INR
CURRENCY_SYMBOL=₹
TAX_RATE=0.05                  # assumed GST rate: confirm with your accountant
MIN_DRIVER_AGE=21
CHAUFFEUR_DAILY_RATE=1200
YOUNG_DRIVER_FEE_PER_DAY=300
CHATBOT_PROVIDER=rules
