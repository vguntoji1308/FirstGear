# DEV environment template. Copy to config/dev.env (git-ignored) and edit.
#   cp config/dev.env.example config/dev.env
# Real environment variables always override this file. NEVER commit real secrets.

APP_ENV=dev
PORT=3000
DB_PATH=./data/dev.sqlite
SEED_DEMO_DATA=true            # demo reviews/testimonials for a lively dev site

# --- Secrets (dev may omit them: random values are generated at startup and printed once) ---
JWT_SECRET=
ADMIN_EMAIL=admin@localhost.test
ADMIN_PASSWORD=

# --- Web security ---
CORS_ORIGINS=                  # empty = same-origin only; comma-separated list to allow others
TRUST_PROXY=false
RATE_LIMIT_MAX=1000            # relaxed for dev/testing
RATE_LIMIT_WRITE_MAX=100
RATE_LIMIT_LOGIN_MAX=20

# --- Optional customer phone sign-in: Twilio Verify (real SMS; no mock fallback) ---
# Create an SMS Verify Service in Twilio. Keep credentials in this ignored env file or secret store.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Business details (placeholders - safe to change) ---
BUSINESS_NAME=FirstGear Car Rentals
GOOGLE_REVIEWS_URL=            # blank = default Google Maps search link
BUSINESS_PHONE=+91 96533 13974   # click-to-call number (taken from the FirstGear demo site)
BUSINESS_EMAIL=firstgearcarzit@gmail.com
BUSINESS_ADDRESS=No 51/A, Ganesh Nagar, Veeriyampalayam Road, Kalapatti Post, Coimbatore 641048
BUSINESS_HOURS=Daily 08:00-20:00   # not on the source site: confirm
SOCIAL_FACEBOOK=https://www.facebook.com/myfirstgear
SOCIAL_INSTAGRAM=https://www.instagram.com/myfirstgear/
SOCIAL_X=https://x.com/myfirstgear
SOCIAL_YOUTUBE=https://www.youtube.com/@myfirstgear
SOCIAL_WHATSAPP=https://wa.me/919653313974

# --- Optional Google reviews sync (see docs/GOOGLE_REVIEWS.md); the key is a SECRET: use your secret store ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Rental rules ---
CURRENCY=INR
CURRENCY_SYMBOL=₹
TAX_RATE=0.05                  # assumed GST rate: confirm with your accountant
MIN_DRIVER_AGE=21
CHAUFFEUR_DAILY_RATE=1200
YOUNG_DRIVER_FEE_PER_DAY=300
CHATBOT_PROVIDER=rules
